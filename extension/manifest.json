{
  "manifest_version": 3,
  "name": "Inspector Dashboard Helper",
  "version": "0.2.0",
  "description": "Inspector shortcuts on member.freemason.org: a presumptive-officer qualification panel, lodge public-page links and committee email.",
  "browser_specific_settings": {
    "gecko": {
      "id": "inspector-ext@clintparker.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    },
    "gecko_android": { "strict_min_version": "142.0" }
  },
  "background": { "scripts": ["background.js"], "type": "module" },
  "permissions": ["storage"],
  "host_permissions": ["https://member.freemason.org/*"],
  "content_scripts": [
    {
      "matches": ["https://member.freemason.org/districts/*"],
      "js": ["content/common.js", "content/panel.js", "content/add-list.js"],
      "css": ["content/panel.css"]
    },
    {
      "matches": ["https://member.freemason.org/mems/*"],
      "js": ["content/common.js", "content/add-member.js"],
      "css": ["content/panel.css"]
    },
    {
      "matches": ["https://member.freemason.org/ous/*"],
      "js": ["content/common.js", "content/lodge-link.js"],
      "css": ["content/panel.css"]
    },
    {
      "matches": ["https://member.freemason.org/public_members/memberships/*"],
      "js": ["content/common.js", "content/committee-mail.js"],
      "css": ["content/panel.css"]
    }
  ]
}
