{
  "name": "inspector-ext",
  "version": "1.0.0",
  "description": "Inspector's dashboard helper for member.freemason.org (Firefox extension)",
  "scripts": {
    "lint": "web-ext lint --source-dir extension --warnings-as-errors",
    "test:unit": "vitest run --dir test/unit",
    "test:e2e": "node test/e2e.mjs",
    "test": "npm run lint && npm run test:unit && npm run test:e2e",
    "build": "web-ext build --source-dir extension --overwrite-dest",
    "dev": "web-ext run --source-dir extension --firefox=deved --verbose --no-input --pref devtools.console.stdout.content=true",
    "screenshot": "node scripts/screenshot.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "puppeteer-core": "^25.16.0",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0"
  },
  "private": true
}
